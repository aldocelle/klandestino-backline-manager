{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "functions": {"api/index.php": {"runtime": "vercel-php@0.9.0", "maxDuration": 30}},
  "routes": [
    {"src":"/api.php", "dest":"/api/index.php"},
    {"src":"/assets/(.*)", "dest":"/public/assets/$1"},
    {"src":"/kit-tama.html", "dest":"/public/index.html"},
    {"src":"/", "dest":"/public/index.html"},
    {"src":"/(.*)", "status":404}
  ]
}
